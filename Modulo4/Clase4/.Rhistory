#   | José Julián Alcalá Alcántara |
#   | Melissa González Cortés |
################################################################################
################################################################################
#### C A R GA  D E  L I B R E R I A S
library(insurancerating)
library(dplyr)
library(ggplot2)
library(statmod)
library(scales)
library(tweedie)
library(tidymodels)
library(glmmTMB)
library(DHARMa)
### L A Y O U T
# veh value: vehicle value, in $10, 000s
# exposure: 0-1
# clm: occurrence of claim (0 = no, 1 = yes)
# numclaims: number of claims
# claimcst0: claim amount (0 if no claim)
#
# veh body: vehicle body, coded as c(BUS CONVT COUPE
# HBACK HDTOP MCARA MIBUS PANVN RDSTR SEDAN
# STNWG TRUCK UTE)
# veh age: 1 (youngest), 2, 3, 4
# gender: a factor with levels F M
# area: a factor with levels A B C D E F
# agecat: 1 (youngest), 2, 3, 4, 5, 6
df <- read.csv("car.csv")
# Resumen descriptivo de la base
summary(df)
# Tabla con tipos de datos
glimpse(df)
# Conteo de la cantidad de reclamaciones
N_claims <- as.data.frame(table(df$numclaims))
# N_claims <- data.frame("Valor" : c(0,1,2,3,4),
#              "Frecuencia ": table(df$numclaims)
#              )
# Convertimos a tipo factor
df <- df %>%
mutate(
area = as.factor(area),
gender = as.factor(gender),
veh_body = as.factor(veh_body),
agecat = as.factor(agecat),
veh_age = as.factor(veh_age),
veh_value = veh_value*10000
)
# Graficamos la frecuencia
p<-ggplot(N_claims, aes(x = Var1, y = Freq,fill=factor(Var1))) +
geom_bar(stat = "identity") +
geom_text(aes(label = sprintf("%.2f%%",Freq/sum(Freq)*100)),
vjust = -.5)+
ggtitle("Número de reclamaciones")+
theme(plot.title = element_text(color="blue", size=20, face="bold.italic"))+theme(legend.position = "none")
p # Observamos que el 93% de la cartera no ha generado reclamaciones.
# - Con esta informaci ́on: Construya un modelo para la prima pura
# de riesgo ajustando un modelo para la frecuencia de
# reclamaciones y otro para la severidad de las mismas
### F R E C U E N C I A
mod_freq <- glm(
numclaims ~ agecat +veh_body + veh_age,             # Se omiten las variables: area, gender
offset = log(exposure),
family = poisson(),
data = df
)
summary(mod_freq)
### S E V E R I D A D
mod_sev <- glm(
claimcst0 ~ agecat + veh_age+ gender,   # Se omite las variables: area, veh_body
weights = numclaims,
family = inverse.gaussian(link = "inverse"),
data = df %>% filter(claimcst0 > 0)
)
mod_sev2 <- glm(
claimcst0 ~ agecat + veh_age + area + gender,   # Se omite las variables: veh_body
weights = numclaims,
family = inverse.gaussian(link = "inverse"),
data = df %>% filter(claimcst0 > 0)
)
summary(mod_sev)
summary(mod_sev2)
# Hipótesis alternativa (\(H_{1}\)): El modelo complejo (mod_sev2) es significativamente mejor que el modelo simple (mod_sev).
anova(mod_sev2,mod_sev)     # Nos quedamos con el segundo ajuste
# - Eval ́ue la bondad de ajuste de su modelo
### F R E C U E N C I A
set.seed(123)
res_freq <- check_residuals(mod_freq, n_simulations = 700)
autoplot(res_freq)
###
# Hipótesis nula (\(H_{0}\)): El parámetro de dispersión es igual a 1 (dispersión adecuada / ausencia de sobredispersión o subdispersión).
#
# Hipótesis alternativa (\(H_{1}\)): El parámetro de dispersión es diferente de 1 (existe sobredispersión o subdispersión).
check_overdispersion(mod_freq)          # P value menor a 0.001 por lo que se rechaza H_0
simulation_res <- simulateResiduals(fittedModel = mod_freq, plot = F)
plot(simulation_res)
# Si el valor p (p-value) es significativo (\(p < 0.05\)), se rechaza la hipótesis nula, lo que indica un problema de exceso de ceros (inflación) o falta de ceros.
#
# Si el valor p no es significativo, no se rechaza \(H_{0}\), lo que implica que el modelo es adecuado en cuanto a la cantidad de ceros.
testZeroInflation(mod_freq)   ### NO HAY INFORMACION SUFICIENTE QUE COMPRUEBE QUE SE PUEDE RECHAZAR H0
model_performance(mod_freq)  ### El modelo presenta un RMSE de 0.275, lo que indica que el error es pequeño.
### S E V E R I D A D
library(SuppDists)
res_sev <- check_residuals(mod_sev2, n_simulations = 5000)
autoplot(res_sev)
simulation_res2 <- simulateResiduals(fittedModel = mod_sev2, plot = F)
plot(simulation_res2)
model_performance(mod_sev2)
### Construcción de un modelo de prima
premium_df <- df |>
add_prediction(mod_freq, mod_sev2) |>
mutate(premium = pred_nclaims_mod_freq * pred_amount_mod_sev)
add_prediction(mod_freq, mod_sev2)
df |>
add_prediction(mod_freq, mod_sev2)
premium_df <- df |>
add_prediction(mod_freq, mod_sev2) |>
mutate(premium = pred_numclaims_mod_freq * pred_claimcst0_mod_sev2)
head(premium_df)
prima_model <- glm(
premium ~ agecat + veh_age + area + gender,
weights = exposure,
family = inverse.gaussian(link = "inverse"),
data = premium_df
)
prima_model
rt <- rating_table(prima_model)
rt
rating_table(prima_model) |>
autoplot()
summary(prima_model)
model_performance(prima_model)
set.seed(123)
res_prima_model <- check_residuals(prima_model, n_simulations = 250)
autoplot(res_prima_model)
simulation_res_prima_model <- simulateResiduals(fittedModel = prima_model, plot = F)
plot(simulation_res_prima_model)
fit_tw = glmmTMB( claimcst0 ~ agecat + veh_age + area + gender, weights = exposure, family = tweedie(link = "log"), data=df)
summary(fit_tw)
fit_tw = glmmTMB( claimcst0 ~ agecat + veh_age + area + gender +veh_value, weights = exposure, family = tweedie(link = "log"), data=df)
summary(fit_tw)
fit_tw = glmmTMB( claimcst0 ~ agecat + veh_age + area + gender + veh_value, weights = exposure, family = tweedie(link = "log"), data=df)
fit_tw = glmmTMB(claimcst0 ~ agecat + veh_age + area + gender, weights = exposure, family = tweedie(link = "log"), data=df)
summary(fit_tw)
